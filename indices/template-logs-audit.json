{
  "index_patterns": ["logs-audit-*"],
  "priority": 300,
  "composed_of": [
    "logs-settings",
    "logs-base"
  ],
  "_meta": {
    "installed": true,
    "write_alias": "logs-audit",
    "catch_all": false,
    "allow_ignore_malformed": false,
    "description": "Audit records from one internal library, so the field set is closed and there is no catch-all. No `labels` here on purpose: an arbitrary key that reaches the index comes from a request body, and a mapping explosion in the index you are least allowed to delete is not a recoverable mistake. A rejected audit write is the correct outcome.",
    "hand_authored": true
  },
  "template": {
    "settings": {
      "index": {
        "lifecycle": {
          "name": "logs-audit",
          "rollover_alias": "logs-audit"
        },
        "number_of_replicas": 1,
        "refresh_interval": "30s"
      }
    },
    "mappings": {
      "dynamic": "strict",
      "_source": {"enabled": true},
      "properties": {
        "event": {
          "properties": {
            "action": {"type": "keyword"},
            "category": {"type": "keyword"}
          }
        },
        "user": {
          "properties": {
            "id": {"type": "keyword"},
            "name": {"type": "keyword"},
            "roles": {"type": "keyword"}
          }
        },
        "organization": {
          "properties": {
            "id": {"type": "keyword"}
          }
        },
        "source": {
          "properties": {
            "ip": {"type": "ip"}
          }
        }
      }
    }
  }
}
